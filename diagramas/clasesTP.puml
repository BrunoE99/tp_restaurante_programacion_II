@startuml Trabajo practico

skinparam classAttributeIconSize 0

enum CATEGORIA {
    CARNE,
    ENSALADA,
    BEBIDA,
    POSTRE
}

enum ESTADO_ITEM {
    PENDIENTE
    EN_PREPARACION
    LISTO
}

enum ESTADO_PEDIDO {
    EN_CONSTRUCCION
    CONFIRMADO
    FACTURADO
}

enum DIA_SEMANA {
    DOMINGO
    LUNES
    MARTES 
    MIERCOLES
    JUEVES
    VIERNES
    SABADO 
}

class GestorPedidos {
    - pedidosEnCurso: Map<number, Pedido>
    - historialDePedidos: Map<number, Pedido>
    - primeraEstacion: Estacion
    - numerador: NumeradorPedidos

    + registrarPedido(fabrica: FabricaPedido): number
    + getPedidoEnCurso(numero: number): Pedido
    + pedidoPago(numero: number, medioPago: MediosDePago)
    + getHistorial(): Pedido[]
    + consultarHistorialPedido(numPedido: number): Pedido
    + agregarProducto(numero: number, producto: Producto)
    + eliminarProducto(numero: number, producto: Producto)
    + confirmarPedido(numero: number)
    + facturarPedido(numero: number)
    - buscarPedidoEnCurso(numero: number): Pedido
    - asignarAEstaciones(pedido: Pedido)
}

class NumeradorPedidos {
    - ultimoNumero: number

    + siguienteNumero(): number
}

interface FabricaPedido {
    + crearPedido(numero: number): Pedido
}

class FabricaPedidoSalon {
    - cliente: Cliente
    - diaSem: CalculoDia
    - numeroMesa: number
    - mediosDePago: MediosDePago | undefined

    + crearPedido(numero: number): Pedido
}

class FabricaPedidoRetiro {
    - cliente: Cliente
    - diaSem: CalculoDia
    - horarioRetiro: number
    - numeroTel: string
    - mediosDePago: MediosDePago | undefined

    + crearPedido(numero: number): Pedido
}

class FabricaPedidoEnvio {
    - cliente: Cliente
    - diaSem: CalculoDia
    - direccion: string
    - mediosDePago: MediosDePago | undefined

    + crearPedido(numero: number): Pedido
}

abstract class Pedido {
    - numeroDePedido: number {readOnly}
    - cliente: Cliente
    - productos: Producto[]
    - itemsPedidos: ItemPedido[]
    - precioTotal: number
    - medioDePago: MediosDePago | undefined
    - estadoDelPedido: ESTADO_PEDIDO
    - diaActual: DIA_SEMANA

    + getNumeroDePedido(): number
    + getMedioDePago(): MediosDePago | undefined
    + setMedioDePago(medioPago: MediosDePago)
    + getEstadoPedido(): ESTADO_PEDIDO
    + getDiaActual(): DIA_SEMANA
    + getPrecioTotal(): number
    + getItemsAPreparar(): ItemPedido[]
    + todosItemsListos(): boolean
    + agregarProducto(producto: Producto)
    + eliminarProducto(producto: Producto)
    + confirmarPedido()
    + facturarPedido()
    # calcularPrecio()
    - validarPedidoEnConstruccion()
    - validarPedidoNoFacturado()
}

class PedidoSalon {
    - numeroDeMesa: number
}

class PedidoRetiro {
    - horarioDeRetiro: number
    - numeroDeTelefono: string
}

class PedidoEnvio {
    - direccionDeEntrega: string
    - costoDeEnvio: number
}

interface MediosDePago {
    + pagoCompletado()
    + aplicaDescuentoEfectivo(): boolean
}

abstract class Tarjeta {
    - medioDePago: MediosDePago
    - numeroTarjeta
    - nombreTitular
    - codigoSeguridad
    - fechaVencimiento
    - saldo
}

class TarjetaCredito {

}

class TarjetaDebito {

}

class Efectivo {

}

class BilleteraVirtual {

}

class Cliente {
    - mesaAsignada

    + pagarPedido()
    + pedirPedido()
}

abstract class Empleado {
    - clientes: Cliente
    - pedidos: Pedido

    + cobrarPedido()
}

class Mozo {
    - gestorDePedido: GestorPedidos
}

class Cadete {

}

class Menu {
    - items: Item[]
    - combos: Combo[]

    + agregarItem(item: Item)
    + eliminarItem(item: Item)
    + consultarItems(): Item[]
    + agregarCombo(combo: Combo)
    + eliminarCombo(combo: Combo)
    + consultarCombos(): Combo[]
}

Interface Producto {
    + getPrecio(): number
    + getItems(): Item[]
}

class Combo implements Producto {
    - items: Item[]
    - beneficio: Beneficio
    - nombre: string

    + getNombre(): string
    + getItems(): Item[]
    + getPrecio(): number
    - getPrecioTotalItems(): number
}

class Item implements Producto {
    - nombre: string
    - precio: number
    - categoria: CATEGORIA

    + getNombre(): string
    + getPrecio(): number
    + getCategoria(): CATEGORIA
    + getItems(): Item[]
}

class ItemPedido {
    - item: Item
    - estado: ESTADO_ITEM

    + getItem(): Item
    + getNombre(): string
    + getCategoria(): CATEGORIA
    + getEstado(): ESTADO_ITEM
    + estaListo(): boolean
    + iniciarPreparacion()
    + marcarListo()
}

interface Beneficio {
    + calcularBeneficio()
}

class BeneficioPorPorcentaje {

}

class BeneficioPorPrecioFijo {

}

interface Descuento {
    + calcularDescuento(pedido: Pedido): number
}

abstract class DescuentoPorcentual implements Descuento {
    - porcentaje: number    

    + calcularDescuento(pedido: Pedido): number
    # abstract aplica(pedido: Pedido): boolean
}

class DescuentoPorPagoEfectivo {
    # aplica(pedido: Pedido): boolean 
}

class DescuentoPorDiaDeSemana {
    - diaQueAplica: DIA_SEMANA
    # aplica(pedido: Pedido): boolean
}

abstract class Estacion {
    - siguiente: Estacion | undefined
    - items: ItemPedido[]
    - itemsEnPreparacion: ItemPedido[]
    - categorias: CATEGORIA[]

    + setSiguiente(estacion: Estacion)
    + recibir(item: ItemPedido)
    + iniciarSiguiente(): ItemPedido
    + finalizar(item: ItemPedido)
    # acepta(item: ItemPedido): boolean
}

class CadenaEstaciones {
    - primeraEstacion: Estacion
    - estaciones: Estacion[]

    + getPrimeraEstacion(): Estacion
    + getEstaciones(): Estacion[]
}

class Parrilla {}

class CocinaFria {}

class Barra {}

class CocinaDulce {}

class CalculoDia {
    - fecha: Date

    + calculoDia(): DIA_SEMANA
}

'relaciones

Pedido <|-- PedidoSalon
Pedido <|-- PedidoRetiro
Pedido <|-- PedidoEnvio

CalculoDia <.. Pedido

GestorPedidos o-- Pedido
GestorPedidos *-- NumeradorPedidos
GestorPedidos o-- Estacion
GestorPedidos ..> FabricaPedido

FabricaPedido <|.. FabricaPedidoSalon
FabricaPedido <|.. FabricaPedidoRetiro
FabricaPedido <|.. FabricaPedidoEnvio
FabricaPedidoSalon ..> PedidoSalon
FabricaPedidoRetiro ..> PedidoRetiro
FabricaPedidoEnvio ..> PedidoEnvio

Empleado <|-- Mozo
Empleado <|-- Cadete

Pedido o-- Producto
Pedido *-- ItemPedido
ItemPedido o-- Item

Menu o-- Item
Menu o-- Combo

Combo o-- Item
Combo o-- Beneficio

Estacion <|-- Parrilla
Estacion <|-- CocinaFria
Estacion <|-- Barra
Estacion <|-- CocinaDulce

Estacion o-- Estacion
Estacion o-- ItemPedido
CadenaEstaciones *-- Estacion

Beneficio <|.. BeneficioPorPorcentaje
Beneficio <|.. BeneficioPorPrecioFijo
DescuentoPorcentual <|-- DescuentoPorDiaDeSemana
DescuentoPorcentual <|-- DescuentoPorPagoEfectivo

Tarjeta <|-- TarjetaCredito
Tarjeta <|-- TarjetaDebito
MediosDePago <|.. Tarjeta

MediosDePago <|.. Efectivo
MediosDePago <|.. BilleteraVirtual

@enduml